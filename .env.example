# 厉影AI 数字人 免费开源工具
# 环境变量参考；程序不会自动加载 .env 文件，请在终端设置环境变量。
# 可选云端服务，可改成兼容地址；调用按所选服务实际额度与计费规则执行。
DIGITALHUMAN_BASE_URL=https://api.openapi.cn/v1

# 在 https://api.openapi.cn 或所选兼容服务获取 Key；不要提交真实 Key。
DIGITALHUMAN_API_KEY=

# 模型
DIGITALHUMAN_CHAT_MODEL=deepseek-v4.1-flash
DIGITALHUMAN_TTS_MODEL=indextts2-v1
DIGITALHUMAN_AVATAR_MODEL=duix-avatar-v1
DIGITALHUMAN_ASR_MODEL=whisper-large-v3-turbo

# 如果令牌分组只覆盖部分模型，可以分别指定
DIGITALHUMAN_CHAT_KEY=
DIGITALHUMAN_TTS_KEY=
